# AI Sales Agent — variables d'environnement
# Copier ce fichier en `.env` (ou définir ces variables dans votre shell / orchestrateur).
# Ne JAMAIS committer de vraies clés. Elles ne sont jamais exposées au frontend.

# --- Serveur ---
PORT=3000
HOST=0.0.0.0
# URL publique de l'application (utilisée pour les liens de réinitialisation)
APP_URL=http://localhost:3000

# --- Base de données (fichier SQLite) ---
DB_PATH=data/sales-agent.db

# --- Sécurité ---
# OBLIGATOIRE en production : valeur aléatoire longue, ex. `openssl rand -hex 32`
SESSION_SECRET=

# --- Environnement ---
# development | production | test
# En mode test, l'API /api/forgot-password retourne le lien de réinitialisation
# (exclusivement pour automatiser les tests — jamais en production).
APP_ENV=development
NODE_ENV=development

# --- IA (Phase 3) ---
# Fournisseur : auto (OpenAI-compatible si AI_API_KEY définie, sinon moteur local)
# | local (moteur déterministe hors-ligne, aucune clé requise)
# | openai (force l'API OpenAI-compatible)
AI_PROVIDER=auto
# Clé API du fournisseur — JAMAIS committer, JAMAIS exposer au frontend
AI_API_KEY=
# URL de base (defaut https://api.openai.com/v1) — permet n'importe quelle API OpenAI-compatible
AI_BASE_URL=
# Modèle de génération (ex. gpt-4o-mini)
AI_MODEL=
# Modèle d'embeddings (prévu pour pgvector — non utilisé par le moteur local)
AI_EMBEDDING_MODEL=

# --- Rate limiting (par IP, glissant) ---
RATE_LIMIT_LOGIN=5
RATE_LIMIT_REGISTER=3
RATE_LIMIT_FORGOT=3
RATE_LIMIT_AI_PER_MIN=30

# --- Automatisation (Phase 5) ---
# Période du tick du planificateur (ms) — min 5000
AUTOMATION_TICK_MS=30000

# --- Canaux / webhooks (Phase 6) ---
# Fenêtre anti-replay des webhooks (minutes)
WEBHOOK_REPLAY_WINDOW_MIN=15
# Clés fournisseurs (JAMAIS committer — elles ne sont JAMAIS exposées au frontend)
# Paiement (Phase 7) : brancher UN fournisseur au minimum pour encaisser
PAYMENT_CARD_KEY=
PAYMENT_CARD_WEBHOOK_SECRET=
PAYMENT_MM_KEY=
PAYMENT_MM_WEBHOOK_SECRET=
PAYMENT_BANK_IBAN=
# Double de paiement de test (UNIQUEMENT en APP_ENV=test — ignoré en production)
PAYMENT_TEST_WEBHOOK_SECRET=

# --- SaaS : trial & super-admin (Phase 8) ---
# Plan et durée du trial accordés à l'inscription
TRIAL_PLAN=STARTER
TRIAL_DAYS=14
# Comptes super-administrateurs (csv d'e-mails) — configure plans/prix & suit les orgs
SUPER_ADMIN_EMAILS=

# --- Mode pilote ---
# true  = toutes les fonctionnalités ouvertes, sans carte bancaire, sans limite d'usage
# false = limites de plan appliquées
# (défaut : true hors APP_ENV=test, false en test pour la suite automatisée)
PILOT_MODE=true
